# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=postgres://postgres:password@localhost:5432/familyos

# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key: server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# AI provider (Phase 3) — OpenAI for OCR / classify / extract
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
