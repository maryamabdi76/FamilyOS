# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=postgres://postgres:password@localhost:5432/familyos

# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key: server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# AI provider — set once a provider is chosen in Phase 3.
# AI_PROVIDER_API_KEY=
